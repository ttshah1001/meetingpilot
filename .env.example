# Copy this file to .env and fill in values. Never commit .env.

# Required for live extraction + planning (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default Claude model
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SQLite file created in the project root on first run
MEETINGPILOT_DB=meetings.db

# Google Calendar (only needed when not using --dry-run)
# Download OAuth Desktop client JSON from Google Cloud Console
# and save it as credentials.json in the project root (gitignored).
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# Treat extractions below this score as "needs review" (not auto-pushed)
LOW_CONFIDENCE_THRESHOLD=0.6
