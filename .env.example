# Copy this file to .env and fill in values. Never commit .env.

# LLM provider for extraction + planning: Google Gemini (free tier, AI Studio)
# Get a key at https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the default Gemini model.
# gemini-flash-lite-latest is used by default because it's on Google's
# most quota-generous free tier (Flash-Lite is built for high-volume
# usage) — gemini-3.5-flash and gemini-3.6-flash both share the same
# 20-requests/day cap per key, which we hit for real during development.
# Confirmed to support both forced function calling and image input.
GEMINI_MODEL=gemini-flash-lite-latest

# Legacy / optional: only needed if you switch back to Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SQLite file created in the project root on first run
MEETINGPILOT_DB=meetings.db

# Google Calendar (only needed when not using --dry-run)
# Download OAuth Desktop client JSON from Google Cloud Console
# and save it as credentials.json in the project root (gitignored).
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# Treat extractions below this score as "needs review" (not auto-pushed)
LOW_CONFIDENCE_THRESHOLD=0.6
